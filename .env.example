# Skopiuj do .env.local i uzupełnij po utworzeniu projektu Supabase.
# Bez tych zmiennych aplikacja działa jak dotychczas (data/app-data.json).

# Supabase — Project Settings → API
SUPABASE_URL=https://twoj-projekt.supabase.co
# Tylko po stronie serwera (Next.js API). Nigdy w kodzie klienta / przeglądarce.
SUPABASE_SERVICE_ROLE_KEY=

# Model danych w Supabase. Brak lub dowolna inna wartość = jeden dokument JSONB
# w app_state (domyślnie). "relational" = znormalizowane tabele przez RPC
# app_data_load / app_data_save. Przełącznik działa bez zmiany schematu.
# DATA_STORAGE=relational

# Opcjonalnie: Vercel Blob (gdy brak Supabase, a token jest ustawiony)
# BLOB_READ_WRITE_TOKEN=

# Opcjonalnie: hasło do całej aplikacji (gdy brak — aplikacja bez logowania)
# APP_ACCESS_PASSWORD=
# Opcjonalnie: osobny sekret do podpisywania sesji (zalecane na produkcji)
# APP_ACCESS_SECRET=

# PIN do edycji planu przyjęć (dzień, godzina, data, fizjo, nazwisko).
# Bez tej zmiennej edycja planu jest otwarta. + / × / zastępstwo działają zawsze.
# APP_ADMISSIONS_EDIT_PIN=
